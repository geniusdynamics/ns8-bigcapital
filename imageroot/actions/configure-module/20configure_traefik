import json
import sys
import agent
import agent.tasks
import os

# Try to parse the stdin as JSON.
# If parsing fails, output everything to stderr
data = json.load(sys.stdin)

# Setup default values
host = data.get("host")
h2hs = data.get("http2https", True)
le = data.get("lets_encrypt", False)

# Talk with agent using file descriptor.
# Setup configuration from user input.
agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", h2hs)
agent.set_env("TRAEFIK_LETS_ENCRYPT", le)

# Make sure everything is saved inside the environment file
# just before starting systemd unit
agent.dump_env()

# Find default traefik instance for current node
default_traefik_id = agent.resolve_agent_id('traefik@node')
if default_traefik_id is None:
    sys.exit(2)


# Two TCP ports are reserved: the web application and the API server
web_port, api_port = os.environ["TCP_PORTS"].split(",")[:2]
agent.set_env("TCP_PORT_WEB", web_port)
agent.set_env("TCP_PORT_API", api_port)
agent.dump_env()

# The upstream envoy proxy sends /api to the server and the rest to the web
# application: do the same with two Traefik routes on the same host
routes = [
    (os.environ['MODULE_ID'], web_port, None),
    (os.environ['MODULE_ID'] + '-api', api_port, '/api'),
]
for instance, port, path in routes:
    route = {
        'instance': instance,
        'url': 'http://127.0.0.1:' + port,
        'host': host,
        'http2https': h2hs,
        'lets_encrypt': le,
        'headers': {"request": {"X-Forwarded-Proto": "https"}},
    }
    if path:
        route['path'] = path
        route['strip_prefix'] = False
    response = agent.tasks.run(agent_id=default_traefik_id, action='set-route', data=route)
    agent.assert_exp(response['exit_code'] == 0, f"The traefik set-route task failed for {instance}")
