#
# Run the system and tenant database migrations with the server image, as
# the upstream migration image does, before the server starts.
#
[Unit]
Description=Bigcapital database migrations
BindsTo=bigcapital.service
Requires=mariadb-app.service
After=bigcapital.service mariadb-app.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
TimeoutStartSec=900
ExecStart=/usr/bin/podman run --rm --name bigcapital-migrations \
    --pod-id-file %t/bigcapital.pod-id \
    --env-file=%E/state/database-config.env \
    --workdir=/app/packages/server \
    ${SERVER_IMAGE} \
    sh -c "node dist/cli.js system:migrate:latest && node dist/cli.js tenants:migrate:latest"
SyslogIdentifier=%u

[Install]
WantedBy=default.target
